# Copy to .env and fill in. Never commit the real .env.
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-flash-latest
ENABLE_SAM=true
SAM_MODEL_ID=facebook/sam2.1-hiera-tiny
# Per-surface distances for measurement (Depth Anything V2 Metric Outdoor Small, Apache-2.0).
ENABLE_DEPTH=true
# SQLite by default; use a Postgres URL (e.g. Neon/Supabase) for persistent cloud storage.
DATABASE_URL=sqlite:///./data/facade.db
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
